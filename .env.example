# Copy to .env. Everything is optional for local use: with nothing set, the app
# runs with an in-memory store and simulated SMS pages. Never commit .env.

# Shared secret the ElevenLabs agents send in the X-Tool-Secret header.
TOOL_SECRET=local-test

# Post-call webhook signing secret (from the ElevenLabs webhook settings).
ELEVENLABS_WEBHOOK_SECRET=
# ALLOW_UNSIGNED_WEBHOOKS=true   # local testing only

# Read-only ElevenLabs key for the Evaluation Lab (server side only).
ELEVENLABS_API_KEY=

# Your own agents (defaults are the public demo agents).
# ELEVENLABS_AGENT_ID=
# FOLLOWUP_AGENT_ID=
# FOLLOW_UPS_PER_HOUR=30

# Supabase (service key stays on the server). Unset = in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# TABLE_PREFIX=ns_

# Real SMS paging for emergencies. Unset = simulated and logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ONCALL_TECH_PHONE=
# ONCALL_TECH_NAME=the on-call technician
# CALLBACK_WINDOW_MINUTES=15
# SMS_MAX_PER_HOUR=5

# Zendesk: a ticket for each board ticket after the call ends (OAuth client credentials,
# scope tickets:write users:write). Unset = off.
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Human review fields: numeric ids printed by scripts/zendesk_review_setup.py. Unset = that field is left off
# (the needs_review tags and the note line still go on).
# ZENDESK_FIELD_REVIEW_NEEDED=
# ZENDESK_FIELD_REVIEW_REASON=
# ZENDESK_FIELD_RECOMMENDED_OPTIONS=

# The "NightAgent Call" Zendesk sidebar app (read-only call details for tickets NightAgent made).
# A long random string, sent in the X-Sidebar-Secret header. Unset = the endpoint is off.
SIDEBAR_SECRET=
# SIDEBAR_REQUESTS_PER_MINUTE=60
