# Copy to bench/.env (git-ignored). Used only by the Jargon Bench, never by the app.
# Needed from build step 3 on; --dry-run and the tests need no keys.

# Deepgram API key (speech-to-text).
DEEPGRAM_API_KEY=

# ElevenLabs API key with Speech to Text (and Text to Speech, for generating the
# tts audio) permission. This is NOT the app's read-only Evaluation Lab key.
# These calls use account credits shared with the live agents, but never call Sam,
# so they don't count toward Sam's daily call limit.
ELEVENLABS_API_KEY=
